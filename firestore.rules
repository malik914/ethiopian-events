rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isOrganizer() { return signedIn() && userDoc().role == 'organizer'; }
    function ownsEvent(eventId) {
      return signedIn() &&
        get(/databases/$(database)/documents/events/$(eventId)).data.organizerUid == request.auth.uid;
    }
    function isAssigned(eventId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/events/$(eventId)/staff/$(request.auth.uid));
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      // Role assignment is an administrative operation, never client-controlled.
      allow create, update, delete: if false;
    }

    match /events/{eventId} {
      allow create: if signedIn() && isOrganizer()
        && request.resource.data.organizerUid == request.auth.uid;
      allow read: if signedIn() &&
        (resource.data.organizerUid == request.auth.uid || isAssigned(eventId));
      allow update, delete: if ownsEvent(eventId);
      match /staff/{staffUid} {
        allow read: if ownsEvent(eventId) || (signedIn() && request.auth.uid == staffUid);
        allow write: if false;
      }
      match /guests/{guestId} {
        allow read: if ownsEvent(eventId) || isAssigned(eventId);
        // Guest creation and check-in are server-only callable operations.
        allow create, update, delete: if false;
      }
    }
  }
}
